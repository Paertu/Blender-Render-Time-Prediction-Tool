import bpy
import time

class EmiToolsPanel(bpy.types.Panel):
    bl_idname = "OBJECT_PT_Emi_Tools"
    bl_label = "Emily's Tools"
    bl_space_type = 'VIEW_3D'
    bl_region_type = 'UI'
    bl_category = "EmiTools"

    def draw(self, context):
        layout = self.layout

        scene = context.scene
        layout.label(text="Estimate Render Time")

        split = layout.split()
        # First column
        col = split.column()
        col.prop(scene, "frame_start")
        # Second column
        col = split.column()
        col.prop(scene, "frame_end")

        col = split.column()
        col.prop(scene, "emi_render_gap")
        
        row = layout.row()
        row.operator("render.start_render_timer", text="Start Timer")

class RENDER_OT_start_timer(bpy.types.Operator):
    bl_idname = "render.start_render_timer"
    bl_label = "Render Timer"
    
    def execute(self, context):
        print("Started Render Esimate")
        start_time = time.time()
        actual_end_frame = context.scene.frame_end
        context.scene.frame_end = context.scene.frame_start + context.scene.emi_render_gap
        bpy.ops.render.render(animation=True)

        end_time = time.time()
        elapsed_time = end_time - start_time
        print(f"Render gap finished in {elapsed_time} seconds")
        context.scene.frame_end = actual_end_frame
        total_frames = (actual_end_frame - context.scene.frame_start) + 1
        print(f"Total frames: {total_frames}")
        sampled_frames = context.scene.emi_render_gap + 1
        print(f"Sampled {sampled_frames} frames")
        render_estimate = (total_frames / sampled_frames) * elapsed_time
        popup_time_text = ""
        if render_estimate < 60:
            popup_time_text = f"Render Expected to take: {render_estimate:.0f} second(s)"
        elif render_estimate < 3600:
            minutes = render_estimate / 60
            popup_time_text = f"Render Expected to take: {minutes:.0f} minute(s)"
        else:
            hours = render_estimate / 3600
            popup_time_text = f"Render Expected to take: {hours:.0f} hours"

        print(popup_time_text)
        self.report({'INFO'}, popup_time_text)

        return {'FINISHED'}

def register():
    bpy.utils.register_class(EmiToolsPanel)
    bpy.utils.register_class(RENDER_OT_start_timer)
    bpy.types.Scene.emi_render_gap = bpy.props.IntProperty(name="Frame Gap", default=5, min=1)
    
def unregister():
    bpy.utils.unregister_class(EmiToolsPanel)
    bpy.utils.unregister_class(RENDER_OT_start_timer)
    del bpy.types.Scene.emi_render_gap

def popup_window(self, context):
    self.layout.label(text=popup_time_text)
    
if __name__ == "__main__":
    try:
        unregister()
    except RuntimeError:
        pass
    register()